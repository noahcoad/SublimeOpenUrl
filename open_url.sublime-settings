// to specify your own, either edit this file, or copy/paste to open_url.sublime-settings file in your User folder
// if there is an open_url.sublime-settings in the User folder, Sublime Text merges those settings with these
{
  // delimiters for expanding selection, these are markdown friendly.
  // text wrapped in any matched pair -- "" '' `` () [] {} <> -- is treated as one
  // token, so a path containing spaces selects whole from any cursor position.
  "delimiters": " \t\n\r\"'`,*<>[](){}",

  // if these delimiting characters are seen at the end of the URL, they are removed, e.g. sublimetext.com.; becomes sublimetext.com
  "trailing_delimiters": ";.:",

  // the browser that Open URL uses to open new tabs
  // it can be an empty string, or a string [from this list](https://docs.python.org/3.3/library/webbrowser.html)
  "web_browser": "",

  // the path to the executable that Open URL uses to open new tabs; overrides "web_browser"
  "web_browser_path": "",
  // example: chrome, osx
  // "web_browser_path": "open -a /Applications/Google\\ Chrome.app %s"
  // example: chrome, windows
  // "web_browser_path": "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe %s"
  // example: chrome, linux
  // "web_browser_path": "/usr/bin/google-chrome %s"

  // if URL is neither a local file nor a web URL, pass it to a web searcher
  "web_searchers": [
    {
      "label": "google search",
      "url": "http://google.com/search?q=",
      "encoding": "utf-8"
    }
  ],

  // when true, deep links only support line numbers (file:42), not :"text" or :/regex/
  "deep_link_line_number_only": false,

  // optional shell command run by Copy Deep Link / Copy Transformed Path; {path} is replaced with
  // the current file's path (shell-quoted), and the command's stdout becomes the new path.
  // example: "/opt/homebrew/bin/python3 ~/scripts/shortpath.py {path}"
  "copy_path_transform": "",

  // terminal app used by the "run in terminal" action. empty = the OS default terminal
  // (on macOS, whichever app opens .command scripts; on Linux, x-terminal-emulator).
  // example, osx: "iTerm"   example, linux: "gnome-terminal"
  "terminal_app": "",

  // when pasting a relative path into a markdown file, wrap the result in backticks
  "paste_relative_path_markdown_backticks": true,

  // character used to enclose a pasted path in NON-markdown views (.txt, plain text, code)
  // when it needs enclosing -- it contains a space or other char that would stop token
  // re-selection, or it carries a deep-link suffix (file.txt:42, :"text", :/regex/).
  // a backtick matches what markdown views do; set to "\"" for double quotes, or ""
  // to disable and fall back to the old behavior (quote only when a char would break
  // re-selection, and never for a bare deep link). if the char already appears in the
  // path, the next available quote (", ', `) is used instead.
  "plain_text_path_wrap_char": "`",

  // character used to enclose a path or deep link put on the clipboard by
  // Copy Deep Link / Copy Transformed Path -- the copy-side mirror of
  // "plain_text_path_wrap_char", same rules, applied at copy time instead of
  // paste time. a deep link (file.txt:42, :"text", :/regex/) is always enclosed;
  // a plain path only when it contains a space or other char that would stop
  // token re-selection. if the char already appears in the path, the next
  // available quote (", ', `) is used instead. set to "" to copy bare.
  // Paste Relative Path strips one enclosing pair, so links round-trip.
  "copy_path_wrap_char": "`",

  // path transforms — applied in order: aliases → search_paths × file_prefixes × file_suffixes
  // first combination that resolves to an existing file or folder wins.
  "aliases": {},

  // directory roots tried as prefixes when resolving a bare path.
  // e.g. with ["src", "lib"], typing "users" looks for "users", "src/users", and "lib/users".
  // example:
  // "search_paths": ["src", "lib", "test"]
  "search_paths": ["src"],

  // string prefixes prepended to the basename when resolving.
  // e.g. with ["_"], typing "helpers" also tries "_helpers".
  // example:
  // "file_prefixes": ["_", "test_"]
  "file_prefixes": [],

  // extensions appended to the basename when resolving a bare name.
  // e.g. with [".js", ".ts"], typing "users" finds "users.js" or "users.ts".
  // heads up: each suffix multiplies the resolve attempts (aliases x search_paths
  // x file_prefixes x file_suffixes), so a long list can add noticeable delay
  // before a non-path falls through to a web search -- ".js" alone has been
  // measured at seconds on a partial URL like //example.com/ (#68). Keep the list
  // to the extensions your projects actually use, or set it to [] to skip the step.
  // example:
  // "file_suffixes": [".js", ".ts", ".tsx"]
  "file_suffixes": [".js"],

  // menu actions shown when the resolved path is a file.
  // each entry: { label, os?, pattern?, commands, kwargs?, terminal?, pause?, pre_command? }
  // the "commands" field accepts:
  //   - an array (argv; the path is appended unless an element contains "$url")
  //   - a string (run via shell; "$url" replaced or path appended)
  //   - a reserved sentinel: "edit_in_sublime", "open_in_new_window", "system_open", "add_to_project", "run_in_terminal"
  // Note: a synthetic "edit" entry is always prepended to this list at runtime,
  // which opens the file in Sublime (honoring any deep-link suffix). No need to
  // include it here.
  "file_custom_commands": [
    { "label": "reveal", "os": "osx",     "commands": ["open", "-R"] },
    { "label": "reveal", "os": "windows", "commands": ["explorer", "/select,"] },
    { "label": "reveal", "os": "linux",   "commands": ["nautilus", "--browser"] },
    { "label": "new window",          "commands": "open_in_new_window" },
    // { "label": "run in terminal",     "commands": "run_in_terminal" },   // paused 2026-09-02, see docs/lessons.md
    { "label": "system open",         "commands": "system_open" }
  ],

  // menu actions shown when the resolved path is a folder
  "folder_custom_commands": [
    { "label": "new window",          "commands": "open_in_new_window" },
    { "label": "reveal", "os": "osx",     "commands": ["open"] },
    { "label": "reveal", "os": "windows", "commands": ["explorer"] },
    { "label": "reveal", "os": "linux",   "commands": ["nautilus", "--browser"] },
    // { "label": "run in terminal",     "commands": "run_in_terminal" },   // paused 2026-09-02, see docs/lessons.md
    { "label": "add to project",      "commands": "add_to_project" }
  ],

  // menu actions for non-file/non-folder text that doesn't look like a URL
  "other_custom_commands": [],

  // list of regex/extension matchers that pre-select a file or folder action.
  // each entry: { os?, pattern? | endswith?, label, action }
  //   os       — "osx" | "windows" | "linux" (omit = all)
  //   pattern  — regex; matches against the resolved path
  //   endswith — array of extensions (e.g. [".sh"]); shorthand for pattern
  //   label    — matches a label in *_custom_commands; or a built-in name
  //   action   — "auto" (skip menu) | "menu" (pre-highlight)
  "autoactions": [
    { "os": "windows", "endswith": [".exe", ".com"], "label": "system open", "action": "auto" },
    { "os": "windows", "endswith": [".bat", ".cmd"], "label": "system open", "action": "menu" },
    { "endswith": [".sublime-project"],              "label": "edit",        "action": "auto" },
    { "endswith": [".txt", ".md", ".log", ".config", ".sublime-settings"],
      "label": "edit", "action": "auto" }
  ]
}
